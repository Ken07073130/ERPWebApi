{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // 本地 SQL Server。TrustServerCertificate=True 是必需的：
  // Microsoft.Data.SqlClient 5.x/6.x 起默认 Encrypt=True（本项目升级到 net10.0 后
  // 实际解析到 6.1.6），本地自签证书会导致 "证书链不受信任" 报错。
  // 生产环境请导入正式证书，不要依赖这个开关。
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ErpDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  // ⚠️ 仅限本地开发的签名密钥，长度需 >= 32 字节。
  // 生产环境务必改用环境变量 Jwt__Key 注入，不要沿用这个值。
  "Jwt": {
    "Key": "dev-only-signing-key-do-not-use-in-production-0123456789"
  }
}
