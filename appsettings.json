{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 连接字符串按环境覆盖：本地写 appsettings.Development.json，
  // 生产用环境变量 ConnectionStrings__Default 注入，不要提交真实口令。
  "ConnectionStrings": {
    "Default": ""
  },

  // Jwt:Key 不放在这里（此文件会进版本库），只放非敏感的签发参数。
  // 生产环境的 Key 通过环境变量 Jwt__Key 或 User Secrets 注入。
  "Jwt": {
    "Issuer": "ERPWebApi",
    "Audience": "ERPWebApi.Client",
    "ExpireMinutes": 120
  }
}
